{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "dataset": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "cases": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "query": {
                "type": "string",
                "minLength": 1
              },
              "domain": {
                "type": "string",
                "enum": [
                  "engineering_claims",
                  "tool_capabilities",
                  "implementation_examples",
                  "paper_case_study_knowledge",
                  "entity_profiles",
                  "model_capabilities",
                  "benchmark_intelligence",
                  "source_native_sections"
                ]
              },
              "queryClass": {
                "type": "string",
                "enum": [
                  "semantic",
                  "lexical",
                  "filtered",
                  "graph",
                  "temporal",
                  "exact",
                  "conceptual",
                  "mixed",
                  "constraint",
                  "multi_hop",
                  "code",
                  "contradiction",
                  "freshness_temporal",
                  "negative_abstention",
                  "adversarial"
                ]
              },
              "provenance": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "relevanceJudgments": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "recordId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "grade": {
                      "anyOf": [
                        {
                          "type": "number",
                          "const": 0
                        },
                        {
                          "type": "number",
                          "const": 1
                        },
                        {
                          "type": "number",
                          "const": 2
                        },
                        {
                          "type": "number",
                          "const": 3
                        }
                      ]
                    },
                    "rationale": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "recordId",
                    "grade",
                    "rationale"
                  ],
                  "additionalProperties": false
                }
              },
              "expectedFilters": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "field": {
                      "type": "string",
                      "minLength": 1
                    },
                    "value": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "number"
                        },
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "array",
                          "items": {
                            "type": [
                              "string",
                              "number",
                              "boolean"
                            ]
                          }
                        }
                      ]
                    }
                  },
                  "required": [
                    "field",
                    "value"
                  ],
                  "additionalProperties": false
                }
              },
              "expectedAbstain": {
                "type": "boolean"
              },
              "partition": {
                "type": "string",
                "enum": [
                  "dev",
                  "calibration",
                  "heldout"
                ]
              },
              "sourceFamily": {
                "type": "string"
              },
              "entityFamily": {
                "type": "string"
              },
              "forbiddenResultIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "forbiddenFilters": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "field": {
                      "type": "string",
                      "minLength": 1
                    },
                    "value": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "number"
                        },
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "array",
                          "items": {
                            "type": [
                              "string",
                              "number",
                              "boolean"
                            ]
                          }
                        }
                      ]
                    }
                  },
                  "required": [
                    "field",
                    "value"
                  ],
                  "additionalProperties": false
                }
              },
              "authorProvenance": {
                "type": "string"
              },
              "reviewerProvenance": {
                "type": "string"
              },
              "fixtureKind": {
                "type": "string",
                "enum": [
                  "real_bundle_grounded",
                  "synthetic_gap",
                  "reviewed_negative",
                  "adversarial"
                ]
              },
              "expectedFacts": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "expectedLocatorDigests": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "requiredResultType": {
                "type": "string"
              },
              "requiredResultTypes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "difficulty": {
                "type": "string",
                "enum": [
                  "easy",
                  "medium",
                  "hard"
                ]
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "policySlice": {
                "type": "string"
              },
              "expectedGraphPath": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "id",
              "query",
              "domain",
              "queryClass",
              "provenance",
              "relevanceJudgments"
            ],
            "additionalProperties": false
          }
        },
        "reviewed": {
          "type": "boolean"
        },
        "reviewMode": {
          "type": "string",
          "enum": [
            "independent",
            "development"
          ]
        },
        "reviewArtifact": {
          "type": "object",
          "properties": {
            "candidateManifestDigest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "authorIdentity": {
              "type": "string",
              "minLength": 1
            },
            "reviewerIdentity": {
              "type": "string",
              "minLength": 1
            },
            "decision": {
              "type": "string",
              "enum": [
                "accept",
                "reject"
              ]
            },
            "reviewedCaseIds": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "reviewedAt": {
              "type": "string",
              "minLength": 1
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          },
          "required": [
            "candidateManifestDigest",
            "authorIdentity",
            "reviewerIdentity",
            "decision",
            "reviewedCaseIds",
            "reviewedAt",
            "rationale",
            "digest"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "version",
        "name",
        "cases",
        "reviewed"
      ],
      "additionalProperties": false
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "caseId": {
            "type": "string",
            "minLength": 1
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "recordId": {
                  "type": "string",
                  "minLength": 1
                },
                "rank": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "score": {
                  "type": "number"
                },
                "matchedFilters": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": [
                            "string",
                            "number",
                            "boolean"
                          ]
                        }
                      }
                    ]
                  }
                },
                "citation": {
                  "type": "object",
                  "properties": {
                    "entailed": {
                      "type": "boolean"
                    },
                    "locatorValid": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "entailed",
                    "locatorValid"
                  ],
                  "additionalProperties": false
                },
                "resultType": {
                  "type": "string"
                },
                "locatorDigests": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "graphPaths": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "contentDigest": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                }
              },
              "required": [
                "recordId",
                "rank",
                "score"
              ],
              "additionalProperties": false
            }
          },
          "abstained": {
            "type": "boolean"
          },
          "latencyMs": {
            "type": "number",
            "minimum": 0
          },
          "costMicros": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "caseId",
          "items",
          "abstained",
          "latencyMs",
          "costMicros"
        ],
        "additionalProperties": false
      }
    },
    "k": {
      "default": 10,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 100
    }
  },
  "required": [
    "dataset",
    "outputs"
  ],
  "additionalProperties": false
}
