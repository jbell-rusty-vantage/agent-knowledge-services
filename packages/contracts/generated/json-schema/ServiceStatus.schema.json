{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "service": {
      "type": "string",
      "const": "knowledge-services"
    },
    "status": {
      "type": "string",
      "enum": [
        "ready",
        "degraded"
      ]
    },
    "contractVersion": {
      "type": "string",
      "const": "v1"
    },
    "runtime": {
      "type": "string",
      "const": "node"
    },
    "databaseRelease": {
      "type": "object",
      "properties": {
        "check": {
          "type": "string",
          "enum": [
            "enforce",
            "warn",
            "off"
          ]
        },
        "range": {
          "type": "string"
        },
        "release": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "type": [
            "string",
            "null"
          ]
        },
        "verdict": {
          "type": "string",
          "enum": [
            "ok",
            "unknown",
            "unstamped",
            "incompatible",
            "inconsistent",
            "not_checked",
            "not_applicable"
          ]
        },
        "warning": {
          "type": "boolean"
        },
        "checkedAt": {
          "type": "string"
        }
      },
      "required": [
        "check",
        "range",
        "release",
        "state",
        "verdict",
        "warning",
        "checkedAt"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "service",
    "status",
    "contractVersion",
    "runtime"
  ],
  "additionalProperties": false
}
