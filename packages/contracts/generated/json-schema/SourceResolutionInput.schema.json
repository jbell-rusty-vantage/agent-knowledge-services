{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "knowledge.source-resolution/v1"
    },
    "candidates": {
      "minItems": 1,
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "candidateId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "identifierKind": {
            "type": "string",
            "enum": [
              "url",
              "doi",
              "arxiv",
              "openreview"
            ]
          },
          "identifier": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "required": [
          "candidateId",
          "identifierKind",
          "identifier"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "candidates"
  ],
  "additionalProperties": false
}
